rules_version = '2';

// 바이브코딩 연수 게시판 Firestore 보안 규칙
// ---------------------------------------------------------------------------
// 인증 구조
//  - 수강생: 익명 로그인 (창을 닫기 전까지 같은 uid 유지)
//  - 강사  : 강사 전용 계정(이메일/비밀번호)으로 로그인 → 서버가 식별 가능
//            (이메일은 js/firebase.js 의 TEACHER_EMAIL 과 반드시 일치)
//
// 글(카드)·댓글 권한
//  - 읽기            : 누구나
//  - 작성            : 로그인 사용자(주소를 아는 누구나), 본인 authorUid 강제
//  - 수정/삭제(카드) : 강사 또는 본인 글만 (창을 닫으면 익명 uid 소멸 → 불가)
//  - 삭제(댓글)      : 강사 / 댓글 작성자 / 글쓴이(자기 글의 댓글 정리용)
//
// 탭·게시판·설정값은 강사가 UI에서 관리하지만, 웹앱 통계 자동 기록 등으로
// 일반 사용자도 써야 하는 필드가 있어 "인증 사용자 쓰기"(소프트)로 둔다.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'teacher@lessonboard.app';
    }
    function ownsCard(columnId, cardId) {
      return get(/databases/$(database)/documents/columns/$(columnId)/cards/$(cardId)).data.authorUid == request.auth.uid;
    }

    // 기존 컬렉션 (개인 앱 · 학습노트) — 레거시, 전체 허용 유지
    match /resources/{resourceId} {
      allow read, write: if true;
    }
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 사이트 설정 / 강사 설정 마커
    match /config/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 탭(상위 묶음)
    match /tabs/{tabId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 게시판(칼럼)
    match /columns/{columnId} {
      allow read: if true;
      allow write: if isSignedIn();

      // 글(카드)
      match /cards/{cardId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        // 수정: 강사·본인. 단 댓글 수(commentCount)만 바꾸는 건 누구나 허용
        // (다른 사람 글에 댓글을 달면 그 글의 댓글 수를 갱신해야 하므로)
        allow update: if isTeacher()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid)
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']));
        allow delete: if isTeacher() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

        // 댓글
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
          allow delete: if isTeacher()
            || (isSignedIn() && resource.data.authorUid == request.auth.uid)
            || (isSignedIn() && ownsCard(columnId, cardId));
        }
      }
    }

  }
}
