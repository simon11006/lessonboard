rules_version = '2';

// 바이브코딩 연수 게시판 Firestore 보안 규칙
// ---------------------------------------------------------------------------
// 내부 연수 전용 게시판입니다. URL을 연수생에게만 공유하는 방식으로 접근을
// 통제하고, 규칙은 단순하게 전체 허용으로 둡니다. (로그인이 없는 익명 구조라
// 작성자/강사 신원을 규칙 단에서 검증할 수 없어 소프트 보호로 운영)
//  - 강사 모드: UI 레벨 비밀번호 보호 (config/teacher 해시)
//  - 글 잠금/숨김: UI 레벨 처리
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // 기존 컬렉션 (개인 앱 · 학습노트)
    match /resources/{resourceId} {
      allow read, write: if true;
    }
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 연수 게시판 컬렉션
    match /config/{docId} {
      allow read, write: if true;
    }
    match /tabs/{tabId} {
      allow read, write: if true;
    }
    match /columns/{columnId} {
      allow read, write: if true;
      match /cards/{cardId} {
        allow read, write: if true;
        match /comments/{commentId} {
          allow read, write: if true;
        }
      }
    }

  }
}
